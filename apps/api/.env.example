# Database connection URL for PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/physnet?schema=public"

# Garage S3 Object Storage Configuration
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_BUCKET="physnet"
S3_ACCESS_KEY_ID="physnet_access_key"
S3_SECRET_ACCESS_KEY="physnet_secret_key"
