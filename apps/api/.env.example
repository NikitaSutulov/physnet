# Database connection URL for PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/physnet?schema=public"

# Garage S3 Object Storage Configuration
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_BUCKET="physnet"
S3_ACCESS_KEY_ID="physnet_access_key"
S3_SECRET_ACCESS_KEY="physnet_secret_key"

# HTTP server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET="63c55794b7a4578419117259fa13ccd33aca6d5e3be2917e904023e4012ae5a2"
JWT_EXPIRES_IN="15m"

# ONOS controller (external instance)
ONOS_URL="http://localhost:8181/onos/v1"
ONOS_USER="onos"
ONOS_PASSWORD="rocks"
ONOS_APP_ID="org.onosproject.physnet"
ONOS_POLL_INTERVAL_MS=5000

# Bootstrap administrator created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@physnet.local"
SEED_ADMIN_PASSWORD="changeme123"
