# Database connection URL for PostgreSQL.
# user, password, port and db name must match POSTGRES_* in the root .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/physnet?schema=public"
# e2e tests use their own database (created, migrated and seeded
# automatically). By default it is DATABASE_URL with "_test" appended to the
# database name; set TEST_DATABASE_URL to use another one.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/physnet_test?schema=public"

# Garage S3 Object Storage Configuration
# Port must match GARAGE_S3_PORT in the root .env. Take the access key id and
# secret from the output of `pnpm infra:garage:init` (the key needs the bucket
# "owner" permission so the API can set CORS for the web client).
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_BUCKET="physnet"
S3_ACCESS_KEY_ID="physnet_access_key"
S3_SECRET_ACCESS_KEY="physnet_secret_key"

# HTTP server
# PORT must match NEXT_PUBLIC_API_URL in apps/web/.env.local;
# CORS_ORIGIN is the web app origin (comma-separated for several).
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET="63c55794b7a4578419117259fa13ccd33aca6d5e3be2917e904023e4012ae5a2"
JWT_EXPIRES_IN="15m"

# ONOS controller (external instance)
ONOS_URL="http://localhost:8181/onos/v1"
ONOS_USER="onos"
ONOS_PASSWORD="rocks"
ONOS_APP_ID="org.onosproject.physnet"
ONOS_POLL_INTERVAL_MS=5000
ONOS_TIMEOUT_MS=5000
# false = no periodic polling; POST /api/sync still works
ONOS_SYNC_ENABLED=true

# Bootstrap administrator created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@physnet.local"
SEED_ADMIN_PASSWORD="changeme123"
