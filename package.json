{
  "name": "physnet",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:api": "pnpm --filter @physnet/api dev",
    "dev:web": "pnpm --filter @physnet/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "db:generate": "pnpm --filter @physnet/api prisma:generate",
    "db:migrate": "pnpm --filter @physnet/api prisma:migrate",
    "db:studio": "pnpm --filter @physnet/api prisma:studio",
    "infra:up": "docker compose up -d",
    "infra:start": "docker compose start",
    "infra:stop": "docker compose stop",
    "infra:down": "docker compose down",
    "infra:garage:init": "./docker/garage/init-garage.sh",
    "format": "prettier --write .",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --recursive exec rm -rf dist .next coverage node_modules",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
